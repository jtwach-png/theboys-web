---
const links = [
  { href: '/#relevant-punch', label: 'Relevant Punch' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#clientes', label: 'Clientes' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="topbar">
  <a href="/" aria-label="The Boys — inicio">
    <img class="logo-mark" src="/wordmark.svg" alt="The Boys" width="140" height="102" />
  </a>
  <nav class="nav">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<style>
  .topbar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) 6vw;
    background: var(--ink);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .logo-mark {
    display: block;
    height: 44px;
    width: auto;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .nav a {
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: rgba(250, 250, 250, 0.7);
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--lime);
  }
</style>
