---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <img class="footer-logo" src="/logo-completo.svg" alt="The Boys — think brave!" width="220" height="240" />
  <div class="footer-meta">
    <p>&copy; {year} Marketing y Publicidad Moob SpA y Locos Chile SpA — The Boys</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-6) 6vw var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-logo {
    height: 140px;
    width: auto;
    margin-bottom: var(--space-4);
  }
  .footer-meta p {
    font-size: 13px;
    color: rgba(250, 250, 250, 0.5);
  }
</style>
