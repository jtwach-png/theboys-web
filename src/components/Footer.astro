---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <img class="footer-logo" src="/wordmark.svg" alt="The Boys" width="120" height="88" />
  <p class="tagline">think brave!</p>
  <div class="footer-meta">
    <p>&copy; {year} Marketing y Publicidad Moob SpA y Locos Chile SpA — The Boys</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-6) 6vw var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-logo {
    height: 64px;
    width: auto;
    margin-bottom: var(--space-3);
  }
  .tagline {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(32px, 5vw, 56px);
    color: var(--paper);
    margin-bottom: var(--space-4);
  }
  .footer-meta p {
    font-size: 13px;
    color: rgba(250, 250, 250, 0.5);
  }
</style>
