---
const faqs = [
  {
    q: '¿Qué es Brave Labs?',
    a: 'Es el laboratorio propio de neurociencia aplicada de The Boys: eye tracking, facial coding, tests de asociación implícita, UX y modelos predictivos. Es un servicio integrado a la oferta de la agencia, único en una agencia de publicidad en Chile.',
  },
  {
    q: '¿Qué significa "Relevant Punch"?',
    a: 'Es el framework propio de The Boys: Marca + Sociedad + Momentos. Cruzamos estas tres variables en cada proyecto para encontrar el golpe relevante para cada marca.',
  },
  {
    q: '¿Cómo empiezo un proyecto con The Boys?',
    a: 'Escríbenos por WhatsApp o agenda un café con nosotros: lo conversamos sin compromiso y desde ahí armamos la propuesta.',
  },
  {
    q: '¿Dónde están ubicados?',
    a: 'En Av. Apoquindo 6550, oficina 205, Las Condes, Santiago de Chile.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="section faq variant-section-faq">
  <p class="section-kicker">Preguntas frecuentes</p>
  <h2 class="section-title">FAQ</h2>
  <div class="faq-list">
    {
      faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>

<style>
  .faq-list {
    max-width: 720px;
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: var(--space-3) 0;
  }
  .faq-item:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 18px;
    color: var(--paper);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::before {
    content: '+ ';
    color: var(--lime);
  }
  .faq-item[open] summary::before {
    content: '− ';
  }
  .faq-item p {
    margin-top: var(--space-2);
    font-size: 14px;
    line-height: 1.6;
    color: rgba(250, 250, 250, 0.7);
  }
</style>
