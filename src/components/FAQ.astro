---
const faqs = [
  {
    q: '¿Qué tipo de trabajos hace The Boys?',
    a: 'De todo, dentro de nuestros servicios: desarrollo digital (sitios web, e-commerce, apps, juegos), campañas creativas y de medios, estrategia de marca y de negocio, consultoría con Neurociencia Aplicada (Brave Lab), experiencia de cliente, y employer branding para equipos internos. Trabajamos tanto proyectos puntuales como relaciones de largo plazo.',
  },
  {
    q: '¿Qué es Brave Lab?',
    a: 'Es el laboratorio propio de Neurociencia Aplicada de The Boys: eye tracking, facial coding, tests de asociación implícita, UX y modelos predictivos. Es un servicio integrado a la oferta de la agencia, único en una agencia de publicidad en Chile.',
  },
  {
    q: '¿Qué significa "Relevant Punch"?',
    a: 'Es el framework propio de The Boys: Marca, Sociedad, Momentos y Atención. Cruzamos estas cuatro variables en cada proyecto para encontrar el golpe relevante para cada marca.',
  },
  {
    q: '¿Trabajan solo con marcas en Chile?',
    a: 'Nuestra base está en Santiago de Chile, pero trabajamos con marcas en toda Latinoamérica: Argentina, Perú, Colombia, México y otros mercados de la región.',
  },
  {
    q: '¿Cómo empiezo un proyecto con The Boys?',
    a: 'Escríbenos por WhatsApp o agenda un café con nosotros: lo conversamos sin compromiso y desde ahí armamos la propuesta.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="section faq">
  <p class="section-kicker">Preguntas frecuentes</p>
  <h2 class="section-title">FAQ</h2>
  <div class="faq-list">
    {
      faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>

<style>
  .faq-list {
    max-width: 720px;
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: var(--space-4) 0;
  }
  .faq-item:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 20px;
    line-height: 1.4;
    color: var(--paper);
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::before {
    content: '+';
    color: var(--lime);
    font-size: 28px;
    line-height: 1;
    flex: none;
  }
  .faq-item[open] summary::before {
    content: '−';
  }
  .faq-item p {
    margin-top: var(--space-3);
    font-size: 15px;
    line-height: 1.75;
    color: rgba(250, 250, 250, 0.7);
  }
</style>
