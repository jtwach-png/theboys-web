---
import poster from '../assets/video-reel-poster.jpg';
---

<section id="reel" class="section reel">
  <p class="section-kicker">The Boys en movimiento</p>
  <h2 class="section-title">Reel</h2>
  <div class="reel-frame">
    <video
      id="reelVideo"
      poster={poster.src}
      preload="none"
      playsinline
      aria-label="Reel de The Boys"
    >
      <source src="/video/theboys-video-2.mp4" type="video/mp4" />
      Tu navegador no soporta la reproducción de este video.
    </video>
    <button class="reel-play" type="button" aria-label="Reproducir reel">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <path fill="currentColor" d="M8 5v14l11-7L8 5z"></path>
      </svg>
    </button>
  </div>
</section>

<style>
  .reel-frame {
    position: relative;
    max-width: 960px;
    border-radius: var(--radius-btn);
    overflow: hidden;
    background: var(--ink);
  }
  .reel-frame video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }
  .reel-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--lime);
    color: var(--ink);
    border: none;
    border-radius: var(--radius-btn);
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .reel-play:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .reel-play.is-hidden {
    display: none;
  }
</style>

<script>
  const video = document.getElementById('reelVideo') as HTMLVideoElement | null;
  const playBtn = document.querySelector<HTMLButtonElement>('.reel-play');

  if (video && playBtn) {
    playBtn.addEventListener('click', () => {
      playBtn.classList.add('is-hidden');
      video.controls = true;
      video.play();
    });
    video.addEventListener('pause', () => {
      if (video.currentTime > 0 && !video.ended) playBtn.classList.add('is-hidden');
    });
  }
</script>
