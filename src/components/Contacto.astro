---
const contactos = [
  {
    nombre: 'José Tomás Wachtendorff',
    rol: 'CSO',
    email: 'josetomas@theboys.cl',
    telefono: '+56 9 8219 0769',
  },
  {
    nombre: 'Miguel Ángel Barahona',
    rol: 'CCO',
    email: 'miguelangel@theboys.cl',
    telefono: '+56 9 9188 4340',
  },
];
---

<section id="contacto" class="section contacto">
  <p class="section-kicker">Hablemos</p>
  <h2 class="section-title">Contacto</h2>
  <div class="contacto-grid">
    {
      contactos.map((c) => (
        <article class="contacto-card">
          <h3>{c.nombre}</h3>
          <p class="rol">{c.rol}</p>
          <a href={`mailto:${c.email}`}>{c.email}</a>
          <a href={`tel:${c.telefono.replace(/\s+/g, '')}`}>{c.telefono}</a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .contacto-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    max-width: 800px;
  }
  .contacto-card {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-btn);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .contacto-card h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 20px;
    color: var(--paper);
  }
  .contacto-card .rol {
    font-size: 13px;
    color: var(--lime);
    margin-bottom: var(--space-2);
  }
  .contacto-card a {
    font-size: 14px;
    color: rgba(250, 250, 250, 0.75);
    text-decoration: none;
  }
  .contacto-card a:hover {
    color: var(--paper);
    text-decoration: underline;
  }
</style>
