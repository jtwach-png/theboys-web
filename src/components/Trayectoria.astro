---
// Logos de premios opcionales en src/assets/logos/premios/<slug>.svg|png
// (ej. "cannes-lions.svg", "clio.svg", "effie.svg"). Sin archivo, se muestra el nombre.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { slugify } from '../utils/slug';

const premios = [
  'El Ojo de Iberoamérica',
  'Effie Awards Global',
  'New York Festivals Advertising Awards',
  'Empresas Creativas de Chile',
  'FIAP',
  'Cannes Lions',
  'Clio Awards',
  'Pinnacle Awards',
  'FePI',
  'Lápiz de Platino',
];

const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/logos/premios/*.{svg,png,jpg,jpeg,webp}',
  { eager: true }
);
const logosBySlug = new Map<string, ImageMetadata>();
for (const [path, mod] of Object.entries(logoModules)) {
  const filename = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  logosBySlug.set(filename, mod.default);
}

const premiosData = premios.map((name) => ({
  name,
  logo: logosBySlug.get(slugify(name)) ?? null,
}));
---

<section id="trayectoria" class="section trayectoria">
  <span class="section-tag">Trayectoria del equipo</span>
  <h2 class="section-title">Reconocimiento en la industria</h2>
  <p class="trayectoria-copy">
    Miembros del equipo de The Boys acumulan reconocimiento en los principales festivales de
    publicidad y creatividad de la industria.
  </p>
  <ul class="premios-row">
    {
      premiosData.map((p) => (
        <li class:list={['premio-tile', { 'has-logo': p.logo }]}>
          {p.logo ? <Image src={p.logo} alt={p.name} width={120} height={48} /> : <span>{p.name}</span>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trayectoria-copy {
    max-width: 640px;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.5;
    color: rgba(250, 250, 250, 0.75);
    margin-bottom: var(--space-4);
  }
  .premios-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
  }
  .premio-tile {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-btn);
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    transition: transform 0.2s ease;
  }
  .premio-tile.has-logo {
    background: var(--paper);
    border-color: transparent;
    padding: var(--space-2) var(--space-4);
  }
  .premio-tile.has-logo:hover {
    transform: scale(1.03);
  }
  .premio-tile span {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 14px;
    color: rgba(250, 250, 250, 0.75);
  }
  .premio-tile :global(img) {
    max-height: 28px;
    width: auto;
    object-fit: contain;
  }
</style>
