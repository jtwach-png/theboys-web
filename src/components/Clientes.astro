---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const entries = (await getCollection('clientes')).sort((a, b) => a.data.order - b.data.order);
---

<section id="clientes" class="section clientes">
  <p class="section-kicker">Marcas que han confiado en The Boys</p>
  <h2 class="section-title">Clientes</h2>
  <ul class="clientes-grid">
    {
      entries.map((c) => (
        <li class:list={['cliente-tile', { 'has-logo': c.data.logo }]}>
          {c.data.logo ? (
            <Image src={c.data.logo} alt={c.data.name} width={160} height={64} />
          ) : (
            <span>{c.data.name}</span>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .clientes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-2);
    list-style: none;
  }
  .cliente-tile {
    min-height: 96px;
    padding: var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-btn);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: transform 0.2s ease;
  }
  /* Los logos reales llegan con fondos/proporciones distintas: una tarjeta blanca
     uniforme absorbe esa inconsistencia en vez de mostrarla contra el negro. */
  .cliente-tile.has-logo {
    background: var(--paper);
    border-color: transparent;
  }
  .cliente-tile.has-logo:hover {
    transform: scale(1.03);
  }
  .cliente-tile span {
    font-size: 14px;
    font-weight: 500;
    color: rgba(250, 250, 250, 0.75);
  }
  .cliente-tile :global(img) {
    max-height: 48px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }
</style>
