---
const services = [
  {
    name: 'Creativity',
    desc: 'Ideas valientes y memorables que venden y generan voz de marca.',
    featured: false,
  },
  {
    name: 'Business Strategy',
    desc: 'Estrategias de alto impacto que crean valor de negocio.',
    featured: false,
  },
  {
    name: 'Brave Labs',
    desc: 'Neurociencia aplicada: eye tracking, facial coding, tests de asociación implícita, UX y modelos predictivos. Única agencia en Chile con laboratorio propio.',
    featured: true,
  },
  {
    name: 'Brand Strategy · Design',
    desc: 'Diseño y estrategia de marca diferenciadora.',
    featured: false,
  },
  {
    name: 'Media · Analytics',
    desc: 'Estrategias de medios y análisis de métricas.',
    featured: false,
  },
  {
    name: 'Experience',
    desc: 'Experiencia de consumidor completa, de punta a punta.',
    featured: false,
  },
  {
    name: 'Digital · Now',
    desc: 'Soluciones digitales: web, juegos, metaverso e IA.',
    featured: false,
  },
  {
    name: 'Inside The Company',
    desc: 'Employer branding y comunicación interna para RRHH.',
    featured: false,
  },
];

const coffeeHref = `https://wa.me/56982190769?text=${encodeURIComponent('Hola, quiero agendar un café con The Boys')}`;
---

<section id="servicios" class="section pilares">
  <p class="section-kicker">Los servicios de The Boys, agencia de publicidad creativa digital en Santiago</p>
  <h2 class="section-title">Nuestros 8 servicios</h2>
  <div class="pilares-grid">
    {
      services.map((s) => (
        <article class:list={['pilar-card', { featured: s.featured }]}>
          {s.featured && (
            <svg class="hand-stroke stroke-circle" viewBox="0 0 220 90" aria-hidden="true">
              <path d="M18,50 C10,20 55,6 108,7 C168,8 208,22 202,48 C196,76 138,86 88,83 C42,80 8,66 14,48" />
            </svg>
          )}
          <h3>{s.name}</h3>
          <p class="pilar-desc">{s.desc}</p>
        </article>
      ))
    }
    <article class="pilar-card cta-card">
      <svg class="hand-stroke stroke-arrow" viewBox="0 0 100 60" aria-hidden="true">
        <path d="M92,6 C60,2 24,16 10,40" />
        <path d="M10,40 L18,28 M10,40 L23,45" />
      </svg>
      <h3>¿Tomamos un café?</h3>
      <p class="pilar-desc">Conversemos sobre tu próximo proyecto, sin compromiso.</p>
      <a class="cta-card-link" href={coffeeHref} target="_blank" rel="noopener noreferrer">
        Agendar un café
      </a>
    </article>
  </div>
</section>

<style>
  .pilares-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .pilar-card {
    background: var(--ink);
    padding: var(--space-4);
    transition: background 0.2s ease;
  }
  .pilar-card:hover,
  .pilar-card:focus-within {
    background: #161616;
  }
  .pilar-card.featured {
    position: relative;
    background: #14101c;
  }
  .pilar-card.featured:hover {
    background: #1a1424;
  }
  .stroke-circle {
    position: absolute;
    top: -6px;
    left: 8px;
    width: 160px;
    height: auto;
    fill: none;
    stroke: var(--red);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .pilar-card h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 20px;
    margin-bottom: var(--space-1);
    color: var(--paper);
  }
  .pilar-card.featured h3 {
    color: var(--lila);
  }
  .pilar-desc {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(250, 250, 250, 0.65);
  }
  .cta-card {
    position: relative;
    background: var(--lime);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
  .stroke-arrow {
    position: absolute;
    right: 10px;
    bottom: 44px;
    width: 90px;
    height: auto;
    fill: none;
    stroke: var(--red);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cta-card:hover {
    background: var(--lime);
    filter: brightness(1.05);
  }
  .cta-card h3 {
    color: var(--ink);
  }
  .cta-card .pilar-desc {
    color: rgba(0, 0, 0, 0.7);
    margin-bottom: var(--space-2);
  }
  .cta-card-link {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 13px;
    color: var(--ink);
    text-decoration: underline;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    gsap.registerPlugin(ScrollTrigger);

    gsap.from('.pilar-card', {
      scrollTrigger: {
        trigger: '.pilares-grid',
        start: 'top 80%',
        once: true,
      },
      opacity: 0,
      y: 24,
      duration: 0.7,
      ease: 'power2.out',
      stagger: 0.06,
    });
  }
</script>
