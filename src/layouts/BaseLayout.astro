---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ReviewToggle from '../components/ReviewToggle.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'The Boys',
  legalName: 'Marketing y Publicidad Moob SpA y Locos Chile SpA',
  url: 'https://theboys.cl',
  logo: 'https://theboys.cl/logo-completo.svg',
  slogan: 'think brave!',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Apoquindo 6550, of. 205',
    addressLocality: 'Las Condes',
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  founder: [
    {
      '@type': 'Person',
      name: 'José Tomás Wachtendorff',
      jobTitle: 'Founder & Chief Strategy Officer',
      email: 'mailto:josetomas@theboys.cl',
    },
    {
      '@type': 'Person',
      name: 'Miguel Ángel Barahona',
      jobTitle: 'Founder & Chief Creative Officer',
      email: 'mailto:miguelangel@theboys.cl',
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <WhatsAppButton />
    <ReviewToggle />
  </body>
</html>
